# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or any file containing real credentials.

# Google AI (Gemini + Imagen) - required
# Get a key from https://aistudio.google.com/
GOOGLE_AI_API_KEY=your_google_ai_api_key
# Optional - Gemini model to use (default: gemini-3.6-flash).
# On a temporary 429/503 the app retries once with gemini-3.5-flash-lite.
GEMINI_MODEL=

# Supabase - required for authentication and health records
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# No service-role key is needed: server routes act as the signed-in user,
# so Row Level Security always applies.

# Base URL used for Supabase auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional - only used by scripts/setup-gcp.js for Google Cloud deployment
GCP_PROJECT_ID=your_gcp_project_id

# Optional - passed through next.config.mjs, not used by application code
CUSTOM_KEY=
